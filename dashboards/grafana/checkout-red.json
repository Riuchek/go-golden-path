{
  "uid": "checkout-red",
  "title": "Checkout RED",
  "description": "Local golden path. Rates come from the collector span-metrics connector (namespace checkout). Orders come from the orders.created instrument. Send traffic with deploy/local/traffic.sh and wait about 30 seconds for the first rate() sample.",
  "tags": ["golden-path", "checkout"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(checkout_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
          "legendFormat": "server"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error ratio",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(checkout_calls_total{span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum(rate(checkout_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
          "legendFormat": "5xx-class spans"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Server latency",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(checkout_duration_seconds_bucket{span_kind=\"SPAN_KIND_SERVER\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(checkout_duration_seconds_bucket{span_kind=\"SPAN_KIND_SERVER\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Orders accepted",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(orders_created_total[5m]))",
          "legendFormat": "orders/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "text",
      "title": "Drive the chart",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 4 },
      "options": {
        "mode": "markdown",
        "content": "Declined payments are `POST /v1/orders` with header `X-Demo-Fault: payment` or sku `fail`. Traces for the same calls are in Jaeger (port 16686). If a panel is empty, open Prometheus (port 9090) and confirm the series; the collector comment in `otel/collector.local.yaml` lists the expected names."
      }
    }
  ]
}
